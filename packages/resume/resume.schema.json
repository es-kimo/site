{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resume",
  "description": "이력서 데이터 스키마 — resume.yaml 작성 시 자동완성 및 검증에 사용됩니다.",
  "type": "object",
  "required": ["basics", "positioning", "skills", "work", "sideProjects", "education", "training", "certifications", "languages", "meta"],
  "additionalProperties": false,
  "definitions": {
    "keyContribution": {
      "type": "object",
      "required": ["problem", "decision", "result"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "description": "한 줄 요약 제목" },
        "problem": { "type": "string", "description": "문제 상황" },
        "decision": { "type": "string", "description": "수행한 판단/행동" },
        "result": { "type": "string", "description": "결과" },
        "ownershipEvidence": {
          "type": "array",
          "items": { "type": "string" },
          "description": "오너십 근거"
        }
      }
    }
  },
  "properties": {
    "basics": {
      "description": "기본 정보 (이름, 연락처, 프로필)",
      "type": "object",
      "required": ["name", "nameKo", "label", "email", "url", "canonical", "summary", "profiles"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "영문 이름" },
        "nameKo": { "type": "string", "description": "한국어 이름" },
        "label": { "type": "string", "description": "직함/역할" },
        "email": { "type": "string", "format": "email" },
        "url": { "type": "string", "format": "uri", "description": "개인 웹사이트 URL" },
        "canonical": { "type": "string", "format": "uri", "description": "웹 이력서 정규 URL" },
        "summary": { "type": "string", "description": "자기소개 요약" },
        "profiles": {
          "type": "array",
          "description": "온라인 프로필 목록",
          "items": {
            "type": "object",
            "required": ["network", "username", "url"],
            "additionalProperties": false,
            "properties": {
              "network": { "type": "string" },
              "username": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "positioning": {
      "description": "포지셔닝 — 대표 역량과 지원 직군",
      "type": "object",
      "required": ["headline", "targetRoles"],
      "additionalProperties": false,
      "properties": {
        "headline": { "type": "string", "description": "한 줄 포지셔닝 메시지" },
        "targetRoles": {
          "type": "array",
          "items": { "type": "string" },
          "description": "지원 직군"
        }
      }
    },
    "skills": {
      "description": "기술 스택",
      "type": "object",
      "required": ["frontend", "testing", "tooling", "design", "collaboration"],
      "additionalProperties": false,
      "properties": {
        "frontend": { "type": "array", "items": { "type": "string" } },
        "testing": { "type": "array", "items": { "type": "string" } },
        "tooling": { "type": "array", "items": { "type": "string" } },
        "design": { "type": "array", "items": { "type": "string" } },
        "collaboration": { "type": "array", "items": { "type": "string" } }
      }
    },
    "work": {
      "description": "경력사항 (회사 단위)",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["company", "location", "department", "position", "startDate", "endDate", "projects"],
        "additionalProperties": false,
        "properties": {
          "company": { "type": "string" },
          "location": { "type": "string" },
          "department": { "type": "string" },
          "position": { "type": "string" },
          "startDate": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}$" },
          "endDate": { "type": "string", "description": "빈 문자열이면 현재 재직" },
          "projects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "period", "role", "featured", "techStack", "oneLiner"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "period": { "type": "string" },
                "role": { "type": "string" },
                "featured": { "type": "boolean" },
                "techStack": { "type": "array", "items": { "type": "string" } },
                "oneLiner": { "type": "string" },
                "keyContributions": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/keyContribution" }
                }
              }
            }
          }
        }
      }
    },
    "sideProjects": {
      "description": "사이드 프로젝트 경험",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "teamSize", "role", "status", "techStack", "oneLiner", "keyContributions"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "teamSize": { "type": "integer", "minimum": 1 },
          "role": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["awarded", "completed", "in-progress"]
          },
          "repoUrl": { "type": "string", "format": "uri" },
          "techStack": { "type": "array", "items": { "type": "string" } },
          "oneLiner": { "type": "string" },
          "keyContributions": {
            "type": "array",
            "items": { "$ref": "#/definitions/keyContribution" }
          }
        }
      }
    },
    "education": {
      "description": "학력사항",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["institution", "location", "area", "startDate", "endDate"],
        "additionalProperties": false,
        "properties": {
          "institution": { "type": "string" },
          "location": { "type": "string" },
          "area": { "type": "string" },
          "startDate": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}$" },
          "endDate": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}$" }
        }
      }
    },
    "training": {
      "description": "직무관련 경험 (부트캠프, 아카데미 등)",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["institution", "location", "course", "startDate", "endDate"],
        "additionalProperties": false,
        "properties": {
          "institution": { "type": "string" },
          "location": { "type": "string" },
          "course": { "type": "string" },
          "startDate": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}$" },
          "endDate": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}$" }
        }
      }
    },
    "certifications": {
      "description": "자격증 목록",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" }
        }
      }
    },
    "languages": {
      "description": "언어 역량",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "level"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "level": { "type": "string" }
        }
      }
    },
    "meta": {
      "description": "메타 정보",
      "type": "object",
      "required": ["version", "lastModified"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" },
        "lastModified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
